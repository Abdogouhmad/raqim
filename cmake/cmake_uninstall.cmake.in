if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
    message(FATAL_ERROR "Cannot find install manifest: @CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt\n"
                         "Did you run 'cmake --install' first?")
endif()

file(READ "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" installed_files)
string(REGEX REPLACE "\n" ";" installed_files "${installed_files}")

foreach(file ${installed_files})
    set(target_file "$ENV{DESTDIR}${file}")
    if(IS_SYMLINK "${target_file}" OR EXISTS "${target_file}")
        message(STATUS "Removing: ${target_file}")
        execute_process(
            COMMAND "@CMAKE_COMMAND@" -E remove "${target_file}"
            RESULT_VARIABLE remove_result
        )
        if(NOT remove_result EQUAL 0)
            message(FATAL_ERROR "Failed to remove: ${target_file}")
        endif()
    else()
        message(STATUS "Already gone: ${target_file}")
    endif()
endforeach()
